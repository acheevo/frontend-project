{
  "name": "frontend-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "check": "npm run lint && npm run build",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --ci",
    "build:storybook": "storybook build --disable-telemetry",
    "test:stories": "vitest run --project storybook",
    "ui:prompt": "node --input-type=module -e \"import { generationPrompt } from './src/generative/catalog.ts'; console.log(generationPrompt())\""
  },
  "dependencies": {
    "@json-render/core": "^0.23.2",
    "@json-render/react": "^0.23.2",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-mcp": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "eslint-plugin-react-x": "^5.30.6",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^26.13.1",
    "npm": "^11.20.0"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "14.0.6"
    }
  }
}
